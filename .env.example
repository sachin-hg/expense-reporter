# Anthropic API key — get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Gmail app passwords — one per account
# To generate: Google Account → Security → 2-Step Verification → App passwords
GMAIL_ACCOUNT1_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
GMAIL_ACCOUNT2_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Local mode PDF passwords (--local <folder>)
# Key = PASS_ + first 4 characters of the filename (case-sensitive)
# Files with no matching key are assumed to be unprotected
# Examples:
#   5268XXXXXXXXXX70_22-01-2026_455.pdf  →  PASS_5268=yourpassword
#   5523XXXXXXXXXX19_22-01-2026_976.pdf  →  PASS_5523=yourpassword
#   5524XXXXXXXX2008_1033566_Retail....  →  PASS_5524=yourpassword
#   Paytm_Statement_April_2026.pdf       →  PASS_Payt=yourpassword
PASS_5268=
PASS_5523=
PASS_5524=
PASS_Payt=
